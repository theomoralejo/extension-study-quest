# Copie para .env no servidor e preencha com os valores reais.
# O .env NUNCA e versionado (ver .gitignore).

DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=study_quest_db

# Chave exigida no header x-api-key.
API_KEY=

# Origens permitidas no CORS, separadas por virgula.
# Vazio = qualquer origem (nao recomendado em producao).
ALLOWED_ORIGINS=https://crm.zoho.com,https://crm.zoho.eu

PORT=3050
