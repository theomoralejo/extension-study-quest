# Copie para .env ao lado do server.js (chmod 600). Nunca versionar o .env.
DB_HOST=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=study_quest_db
DB_POOL=5
PORT=3050

# Quem confere o login da extensão (rota /api/attrio/extensao-study-quest/me).
MASTER_TABLE_URL=https://api.master.studyquestuk.com

# Transição: a chave fixa das versões antigas (até a 1.8.x) é PÚBLICA no GitHub. Com uma data aqui
# ela só LÊ, e só até essa data (UTC); depois é recusada sozinha. Vazio = recusada.
ACEITAR_CHAVE_ANTIGA_ATE=
API_KEY=
