{
  "manifest_version": 3,
  "name": "Study Quest Extension",
  "version": "1.1.0",
  "description": "Adicione respostas rápidas às notas do Zoho CRM",
  "browser_specific_settings": {
    "gecko": {
      "id": "study-quest-extension@studyquestuk.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.zoho.com/*",
    "https://*.zoho.eu/*",
    "https://cv.studyquestuk.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*.zoho.com/*",
        "https://*.zoho.eu/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zoho.com/crm/*",
        "https://*.zoho.eu/crm/*"
      ],
      "js": [
        "browser-api.js",
        "config.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
