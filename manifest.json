{
  "manifest_version": 3,
  "name": "Study Quest Extension",
  "version": "1.7.5",
  "description": "Respostas rapidas nas notas do Zoho CRM, painel lateral de notas, botao de WhatsApp, copiar campo e historico de alteracoes de campo em qualquer modulo",
  "browser_specific_settings": {
    "gecko": {
      "id": "study-quest-extension@studyquestuk.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.zoho.com/*",
    "https://*.zoho.eu/*",
    "https://*.zoho.uk/*",
    "https://*.zoho.in/*",
    "https://*.zoho.com.au/*",
    "https://*.zoho.jp/*",
    "https://*.zohocloud.ca/*",
    "https://*.zoho.sa/*",
    "https://cv.attriostudio.com/*",
    "https://cv.studyquestuk.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*.zoho.com/*",
        "https://*.zoho.eu/*",
        "https://*.zoho.uk/*",
        "https://*.zoho.in/*",
        "https://*.zoho.com.au/*",
        "https://*.zoho.jp/*",
        "https://*.zohocloud.ca/*",
        "https://*.zoho.sa/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zoho.com/crm/*",
        "https://*.zoho.eu/crm/*",
        "https://*.zoho.uk/crm/*",
        "https://*.zoho.in/crm/*",
        "https://*.zoho.com.au/crm/*",
        "https://*.zoho.jp/crm/*",
        "https://*.zohocloud.ca/crm/*",
        "https://*.zoho.sa/crm/*"
      ],
      "js": [
        "browser-api.js",
        "config.js",
        "zoho-api.js",
        "drag.js",
        "placeholders.js",
        "field-history.js",
        "notes-panel.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "field-history.css",
        "notes-panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
