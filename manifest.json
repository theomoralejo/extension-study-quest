{
  "manifest_version": 3,
  "name": "Study Quest Extension",
  "version": "1.0.0",
  "description": "Adicione respostas rápidas às notas do Zoho CRM",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.zoho.com/*",
    "https://*.zoho.eu/*",
    "https://cv.studyquestuk.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*.zoho.com/*",
        "https://*.zoho.eu/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zoho.com/crm/*",
        "https://*.zoho.eu/crm/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}